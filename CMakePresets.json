{
  "version": 6,
  "configurePresets": [
    {
      "name": "windows-x64",
      "generator": "Ninja",
      "binaryDir": "build/windows-x64",
      "toolchainFile": "cmake/ToolchainWindows-x64.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "XILE_PLATFORM": "win32",
        "XILE_ARCH": "x64"
      }
    },
    {
      "name": "windows-arm64",
      "generator": "Ninja",
      "binaryDir": "build/windows-arm64",
      "toolchainFile": "cmake/ToolchainWindows-ARM64.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "XILE_PLATFORM": "win32",
        "XILE_ARCH": "arm64"
      }
    },
    {
      "name": "macos-x86_64",
      "generator": "Ninja",
      "binaryDir": "build/macos-x86_64",
      "toolchainFile": "cmake/ToolchainMacOS-x86_64.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "XILE_PLATFORM": "macos",
        "XILE_ARCH": "x86_64"
      }
    },
    {
      "name": "macos-arm64",
      "generator": "Ninja",
      "binaryDir": "build/macos-arm64",
      "toolchainFile": "cmake/ToolchainMacOS-ARM64.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "XILE_PLATFORM": "macos",
        "XILE_ARCH": "arm64"
      }
    }
  ],
  "buildPresets": [
    { "name": "windows-x64", "configurePreset": "windows-x64" },
    { "name": "windows-arm64", "configurePreset": "windows-arm64" },
    { "name": "macos-x86_64", "configurePreset": "macos-x86_64" },
    { "name": "macos-arm64", "configurePreset": "macos-arm64" }
  ]
}
